# ── Base de datos (Supabase / PostgreSQL) ────────────────────────────────────
# URL con PgBouncer para Prisma en producción (connection pooling)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# URL directa para migraciones (sin pooler)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"  # nunca exponer al cliente

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_DOMAIN="kinexo.ar"
# En desarrollo usar subdominio de localhost: centro.localhost:3000
